{
  "name": "resilience-alpha",
  "private": true,
  "version": "0.1.0",
  "description": "Plateforme de paiement fictive à reprise autonome (Workshop EPSI M2 2026-27)",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky && npm run build:shared",
    "build:shared": "npm run build -w packages/shared",
    "format": "prettier --write .",
    "check:secrets": "bash scripts/check-secrets.sh",
    "db:up": "bash scripts/dev-db.sh up",
    "db:init": "bash scripts/dev-db.sh init",
    "db:down": "bash scripts/dev-db.sh down",
    "docs:api": "docker compose -f docs/docker-compose.yml up",
    "test": "bash scripts/run-tests.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "prettier": "^3.3.3"
  }
}
