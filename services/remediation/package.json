{
  "name": "@resilience/remediation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Moteur de remédiation : reçoit les incidents, exécute les playbooks, prouve la reprise par une transaction de test",
  "scripts": {
    "generate": "prisma generate",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "pretest": "prisma generate",
    "test": "vitest run",
    "migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@resilience/shared": "^0.1.0",
    "dockerode": "^5.0.1",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "jose": "^6.2.13",
    "nodemailer": "^10.2.0",
    "prisma": "^7.10.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
