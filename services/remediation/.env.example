# Modèle de configuration du service remediation. Valeurs de développement local : copier en `.env`
# et ça fonctionne tel quel avec `npm run dev -w services/remediation` (après auth et api).
# En Docker Compose, ces variables sont fournies par le conteneur : ce fichier n'y est pas lu.

NODE_ENV=development
PORT=3002 # 3000 (auth) et 3001 (api) déjà pris en local ; en Docker chaque conteneur a son propre 3000
# Base PostgreSQL locale partagée (voir `npm run db:up` à la racine). En Docker :
# postgresql://remediation_user:<mot de passe>@db-remediation:5432/remediation
DATABASE_URL=postgresql://postgres:test@localhost:54329/remediation_dev
TEST_DATABASE_URL=postgresql://postgres:test@localhost:54329/remediation_test

# Vérification des jetons de ceux qui nous appellent (le détecteur, le dashboard)
AUTH_JWKS_URL=http://localhost:3000/.well-known/jwks.json
JWT_ISSUER=resilience-auth
JWT_AUDIENCE=resilience-platform

# Notre identité auprès d'auth, pour la transaction de test. Même valeur que
# SEED_SVC_REMEDIATION_SECRET dans services/auth/.env.
AUTH_URL=http://localhost:3000
API_URL=http://localhost:3001
REMEDIATION_CLIENT_ID=svc-remediation
REMEDIATION_CLIENT_SECRET=dev-remediation-secret

# Services dont on vérifie la disponibilité (GET <url>/readyz) : nom=url,nom=url
SUPERVISED_SERVICES=auth=http://localhost:3000,api=http://localhost:3001

# Liste de blocage lue par le WAF (volume partagé avec lui) et durée d'un blocage.
# En local : fichier du dépôt (créé au besoin, ignoré par git). En Docker : /waf/denylist.conf (volume).
WAF_DENYLIST_FILE=./waf/denylist.conf
# Conteneur du WAF à recharger (signal HUP) après chaque écriture. À confirmer avec la cyber.
# WAF_RELOAD_CONTAINER=waf
BLOCK_DURATION_SECONDS=300
# IP qu'on ne bloque jamais
PROTECTED_IPS=127.0.0.1,::1,192.168.137.1

# Politique : en dessous, on enregistre mais on n'agit pas
MIN_SCORE=0.6
MIN_FAILURES=5
DEDUP_COOLDOWN_SECONDS=60

# Vérification de la reprise : essais de la transaction de test et délai entre deux essais
VERIFY_ATTEMPTS=5
VERIFY_INTERVAL_MS=2000
HTTP_TIMEOUT_MS=3000

# Accès à Docker par le proxy filtré (jamais le socket brut) et conteneurs autorisés.
# Vide en local : la remédiation "docker" (restart_service) reste inactive, signalé proprement.
# En Docker Compose : DOCKER_HOST=tcp://docker-socket-proxy:2375
ALLOWED_CONTAINERS=api
TRUST_PROXY=loopback,uniquelocal
