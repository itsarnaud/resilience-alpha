# Modèle de configuration du service remediation. Aucune valeur réelle ici.
# Copier en `.env` (ignoré par git et par Docker). Chargé par `npm run dev`, les tests et Prisma.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://remediation_user:__FROM_SOPS__@db-remediation:5432/remediation
# Base des tests d'intégration (sans elle, ils sont ignorés)
# TEST_DATABASE_URL=postgresql://postgres:test@localhost:54329/remediation_test

# Vérification des jetons de ceux qui nous appellent (le détecteur, le dashboard)
AUTH_JWKS_URL=http://auth:3000/.well-known/jwks.json
JWT_ISSUER=resilience-auth
JWT_AUDIENCE=resilience-platform

# Notre identité auprès d'auth, pour la transaction de test (même secret que SEED_SVC_REMEDIATION_SECRET d'auth)
AUTH_URL=http://auth:3000
API_URL=http://api:3000
REMEDIATION_CLIENT_ID=svc-remediation
REMEDIATION_CLIENT_SECRET=__FROM_SOPS__

# Services dont on vérifie la disponibilité (GET <url>/readyz) : nom=url,nom=url
SUPERVISED_SERVICES=auth=http://auth:3000,api=http://api:3000

# Liste de blocage lue par le WAF (volume partagé avec lui) et durée d'un blocage
WAF_DENYLIST_FILE=/waf/denylist.conf
# Conteneur du WAF à recharger (signal HUP) après chaque écriture. À confirmer avec la cyber.
# WAF_RELOAD_CONTAINER=waf
BLOCK_DURATION_SECONDS=300
# IP qu'on ne bloque jamais
PROTECTED_IPS=127.0.0.1,::1,192.168.137.1

# Politique : en dessous, on enregistre mais on n'agit pas
MIN_SCORE=0.6
MIN_FAILURES=5
DEDUP_COOLDOWN_SECONDS=60

# Vérification de la reprise : essais de la transaction de test et délai entre deux essais
VERIFY_ATTEMPTS=5
VERIFY_INTERVAL_MS=2000
HTTP_TIMEOUT_MS=3000

# Accès à Docker par le proxy filtré (jamais le socket brut) et conteneurs autorisés
# DOCKER_HOST=tcp://socket-proxy:2375
ALLOWED_CONTAINERS=api
TRUST_PROXY=loopback,uniquelocal
