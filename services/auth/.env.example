# Modèle de configuration du service auth. Aucune valeur réelle ici.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://auth_user:__FROM_SOPS__@db-auth:5432/auth
# TEST_DATABASE_URL=postgresql://postgres:test@localhost:54329/auth_test

# Clé privée RSA (PEM). Obligatoire en production.
JWT_PRIVATE_KEY=__FROM_SOPS__
# ou, en local : JWT_PRIVATE_KEY_FILE=./keys/jwt.pem  (openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt.pem)
JWT_ISSUER=resilience-auth
JWT_AUDIENCE=resilience-platform
ACCESS_TOKEN_TTL_SECONDS=900
BCRYPT_ROUNDS=10

TRUST_PROXY=loopback,uniquelocal

# Seed (voir README)
# SEED_OPERATOR_EMAIL=
# SEED_OPERATOR_PASSWORD=
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_VICTIM_EMAIL=
# SEED_VICTIM_PASSWORD=
# SEED_SVC_DETECTOR_SECRET=
# SEED_SVC_DASHBOARD_SECRET=
# SEED_SVC_REMEDIATION_SECRET=

# --- Connexion du back-office ---
# Reconnaissance faciale : `stub` en développement (refusé en production), `http` avec le vrai service
FACE_VERIFIER=stub
FACE_STUB_RESULT=match
# FACE_SERVICE_URL=http://face:5000   # défaut
# FACE_SERVICE_KEY=__FROM_SOPS__
FACE_MIN_DELAY_MS=400
# Verrouillage : échecs consécutifs, premier blocage (le suivant double, jusqu'au plafond), en secondes
BACKOFFICE_MAX_FAILURES=2
BACKOFFICE_LOCK_SECONDS=300
BACKOFFICE_LOCK_MAX_SECONDS=3600
FACE_REFUSED_COOLDOWN_SECONDS=30
PASSWORD_REFUSED_COOLDOWN_SECONDS=6
BACKOFFICE_SESSION_TTL_SECONDS=120

# --- LED (ESP8266) : broker MQTT. Absent : la LED n'est pas pilotée ---
# MQTT_URL=mqtt://mosquitto:1883
# MQTT_USERNAME=auth
# MQTT_PASSWORD=__FROM_SOPS__
MQTT_LED_TOPIC=resilience/led
LED_GREEN_SOLID_SECONDS=30
LED_RED_SOLID_SECONDS=30
LED_RED_BLINK_SECONDS=6
