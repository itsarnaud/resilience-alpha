# Modèle de configuration du service auth. Aucune valeur réelle ici.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://auth_user:__FROM_SOPS__@db-auth:5432/auth
# TEST_DATABASE_URL=postgresql://postgres:test@localhost:54329/auth_test

# Clé privée RSA (PEM). Obligatoire en production.
JWT_PRIVATE_KEY=__FROM_SOPS__
# ou, en local : JWT_PRIVATE_KEY_FILE=./keys/jwt.pem  (openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt.pem)
JWT_ISSUER=resilience-auth
JWT_AUDIENCE=resilience-platform
ACCESS_TOKEN_TTL_SECONDS=900
BCRYPT_ROUNDS=10

TRUST_PROXY=loopback,uniquelocal

# Seed (voir README)
# SEED_OPERATOR_EMAIL=
# SEED_OPERATOR_PASSWORD=
# SEED_VICTIM_EMAIL=
# SEED_VICTIM_PASSWORD=
# SEED_SVC_DETECTOR_SECRET=
# SEED_SVC_DASHBOARD_SECRET=
# SEED_SVC_REMEDIATION_SECRET=
