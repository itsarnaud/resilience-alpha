# Modèle de configuration du service auth.

NODE_ENV=development
PORT=3000
# Base PostgreSQL locale partagée (voir `npm run db:up` à la racine)
DATABASE_URL=postgresql://postgres:test@localhost:54329/auth_dev
TEST_DATABASE_URL=postgresql://postgres:test@localhost:54329/auth_test

# Clé privée RSA (PEM). Obligatoire en production (SOPS : JWT_PRIVATE_KEY).
# En local : openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out keys/jwt.pem
JWT_PRIVATE_KEY_FILE=./keys/jwt.pem
JWT_ISSUER=resilience-auth
JWT_AUDIENCE=resilience-platform
ACCESS_TOKEN_TTL_SECONDS=900
BCRYPT_ROUNDS=10

TRUST_PROXY=loopback,uniquelocal

# Comptes de démonstration créés par `npm run seed:dev -w services/auth` (voir README)
SEED_OPERATOR_EMAIL=operator@resilience.local
SEED_OPERATOR_PASSWORD=operator-dev-pwd
SEED_ADMIN_EMAIL=admin@resilience.local
SEED_ADMIN_PASSWORD=admin-dev-pwd
SEED_VICTIM_EMAIL=victime@resilience.local
SEED_VICTIM_PASSWORD=azerty123
SEED_SVC_DETECTOR_SECRET=dev-detector-secret
SEED_SVC_DASHBOARD_SECRET=dev-dashboard-secret
SEED_SVC_REMEDIATION_SECRET=dev-remediation-secret

# --- Connexion du back-office ---
# Reconnaissance faciale : `stub` en développement (refusé en production, tout le monde est reconnu),
# `http` avec le vrai service ml/face (voir ml/face/README.md).
FACE_VERIFIER=stub
FACE_STUB_RESULT=match
# http://localhost:5000 normalement ; sur macOS le port 5000 est pris par AirPlay Receiver
# (Réglages Système > Général > AirDrop et Appairage) : couper AirPlay ou démarrer ml/face sur un
# autre port hôte (docker run -p 5050:5000 ...) et ajuster cette URL.
FACE_SERVICE_URL=http://localhost:5000
# FACE_SERVICE_KEY=__FROM_SOPS__
FACE_MIN_DELAY_MS=400
# Verrouillage : échecs consécutifs, premier blocage (le suivant double, jusqu'au plafond), en secondes
BACKOFFICE_MAX_FAILURES=2
BACKOFFICE_LOCK_SECONDS=300
BACKOFFICE_LOCK_MAX_SECONDS=3600
FACE_REFUSED_COOLDOWN_SECONDS=30
PASSWORD_REFUSED_COOLDOWN_SECONDS=6
BACKOFFICE_SESSION_TTL_SECONDS=120

# --- LED (ESP8266) : broker MQTT. Absent : la LED n'est pas pilotée ---
# MQTT_URL=mqtt://mosquitto:1883
# MQTT_USERNAME=auth
# MQTT_PASSWORD=__FROM_SOPS__
MQTT_LED_TOPIC=resilience/led
LED_GREEN_SOLID_SECONDS=30
LED_RED_SOLID_SECONDS=30
LED_RED_BLINK_SECONDS=6
