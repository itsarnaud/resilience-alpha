{
  "name": "@resilience/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Service d'authentification : comptes, connexion, JWT, jetons de service",
  "scripts": {
    "generate": "prisma generate",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "pretest": "prisma generate",
    "test": "vitest run",
    "migrate": "prisma migrate deploy",
    "db:up": "docker start auth-db 2>/dev/null || docker run -d --name auth-db -e POSTGRES_PASSWORD=test -p 54329:5432 postgres:16-alpine",
    "db:init": "docker exec auth-db psql -U postgres -c \"CREATE DATABASE auth_dev\" -c \"CREATE DATABASE auth_test\"",
    "db:down": "docker rm -f auth-db",
    "seed": "node dist/scripts/seed.js",
    "seed:dev": "tsx --env-file=.env src/scripts/seed.ts"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@resilience/shared": "^0.1.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "prisma": "^7.10.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  }
}
