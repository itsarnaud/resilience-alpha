# Modèle de configuration du service api.

NODE_ENV=development
PORT=3001 # 3000 est pris par auth en local
# Base PostgreSQL locale partagée (voir `npm run db:up` à la racine)
DATABASE_URL=postgresql://postgres:test@localhost:54329/payments_dev
TEST_DATABASE_URL=postgresql://postgres:test@localhost:54329/payments_test

# Clés publiques d'auth, pour vérifier les JWT. En local, auth écoute sur 3000.
AUTH_JWKS_URL=http://localhost:3000/.well-known/jwks.json
JWT_ISSUER=resilience-auth
JWT_AUDIENCE=resilience-platform

# Règle anti-fraude : plafond d'un virement par IBAN vers un bénéficiaire (centimes)
EXTERNAL_TRANSFER_LIMIT_CENTS=50000
# Solde offert à l'ouverture d'un compte (argent fictif, centimes)
INITIAL_BALANCE_CENTS=100000
MAX_ACCOUNTS_PER_USER=5

# Proxys de confiance pour lire X-Forwarded-For (le WAF)
TRUST_PROXY=loopback,uniquelocal
