# Optionnel : adresses que Vite proxy en développement pour /auth et /api (voir vite.config.ts et
# "Comment il parle aux services" dans le README). Les valeurs par défaut conviennent déjà si auth
# tourne sur 3000 et api sur 3001 en local ; inutile de copier ce fichier pour ça.
# AUTH_URL=http://localhost:3000
# API_URL=http://localhost:3001
