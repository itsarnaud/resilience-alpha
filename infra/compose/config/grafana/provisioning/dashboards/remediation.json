{
  "uid": "remediation",
  "title": "Remédiation — Reprise autonome",
  "tags": ["resilience-alpha", "remediation"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "État du moteur",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "mappings": [ { "type": "value", "options": {
          "0": { "text": "Nominal" }, "1": { "text": "Incident" },
          "2": { "text": "Remédiation" }, "3": { "text": "Vérification" }, "4": { "text": "Escalade" } } } ],
        "thresholds": { "steps": [
          { "color": "green", "value": null }, { "color": "red", "value": 1 },
          { "color": "orange", "value": 2 }, { "color": "blue", "value": 3 }, { "color": "purple", "value": 4 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "remediation_state" } ]
    },
    {
      "id": 2, "type": "stat", "title": "Cible joignable",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" },
        "mappings": [ { "type": "value", "options": { "0": { "text": "NON" }, "1": { "text": "OUI" } } } ],
        "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "remediation_target_up" } ]
    },
    {
      "id": 3, "type": "stat", "title": "MTTR dernier incident (s)",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "color": { "mode": "thresholds" },
        "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 20 }, { "color": "red", "value": 40 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "remediation_last_recovery_seconds" } ]
    },
    {
      "id": 4, "type": "stat", "title": "Incidents gérés",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum(remediation_incidents_total) or vector(0)" } ]
    },
    {
      "id": 5, "type": "timeseries", "title": "État du moteur au cours du temps (0=nominal … 2=remédiation 3=vérif)",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "max": 4,
        "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 20, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "remediation_state", "legendFormat": "état moteur" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "remediation_target_up", "legendFormat": "cible up" }
      ]
    },
    {
      "id": 6, "type": "logs", "title": "Journal du moteur — timeline de la reprise",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" },
      "targets": [ { "refId": "A", "datasource": { "type": "loki", "uid": "loki" }, "expr": "{container=\"remediation\"}" } ]
    }
  ]
}
