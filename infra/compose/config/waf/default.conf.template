# ============================================================================
#  WAF Resilience-Alpha — reverse proxy ModSecurity, routage par prefixe
#
#  ModSecurity reste actif GLOBALEMENT via conf.d/modsecurity.conf de l'image
#  (non modifie). Ce fichier ne gere QUE le routage, rien d'autre.
#
#  Les 3 fronts React sont compiles pour la racine "/" (assets en /assets/,
#  appels /auth /api /remediation en chemins absolus). On ne peut donc pas les
#  servir sous un sous-chemin sans les rebuilder : chacun a son port dedie, et
#  ils partagent les memes routes API :
#
#    :8080 -> localhost        front       (banque client)
#    :8081 -> localhost:8081   dashboard   (supervision / remediation)
#    :8082 -> localhost:8082   backoffice  (admin + MFA faciale)
#
#    /auth/*        -> auth:3000         (prefixe retire)
#    /api/*         -> api:3000          (prefixe retire)
#    /remediation/* -> remediation:3000  (prefixe retire)
#    / (le reste)   -> front|dashboard|backoffice:8080  selon le port
#
#  Les hotes amont sont resolus a chaud (resolver Docker, defini par l'image) :
#  si un service est momentanement down, seule SA route renvoie 502 — le WAF ne
#  redemarre pas en boucle.
# ============================================================================

# --- Vraie IP client depuis X-Forwarded-For (labo Docker Desktop : sans ça, tout
# le trafic apparait comme la passerelle Docker et le 'deny' bloque tout le monde).
# On ne fait confiance au XFF que lorsqu'il vient des reseaux Docker (passerelles
# NAT par lesquelles tout le trafic externe entre sur Docker Desktop), jamais d'un
# client arbitraire. Couvre les reseaux Compose (172.16/12), la passerelle hote de
# Docker Desktop (192.168.65.0/24) et un eventuel reseau overlay (10/8).
# Limite assumee : le XFF reste falsifiable en bordure (voir docs). En prod Linux,
# le WAF voit l'IP reelle directement et ceci devient inutile.
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from 10.0.0.0/8;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# --- Front : banque client -> http://localhost/ ---
server {
    listen 8080 default_server;
    server_name _;
    client_max_body_size 12m;

    # Liste de blocage d'IP pilotee par la remediation (volume partage, recharge
    # par signal HUP). Glob tolerant : si le fichier n'existe pas encore, nginx
    # demarre quand meme. Au niveau server -> deny applique a toutes les routes.
    include /etc/nginx/denylist/*.conf;

    location / {
        set $app front;
        proxy_pass http://$app:8080;
        include includes/proxy_common.conf;
    }

    include includes/waf_api_routes.conf;
    include includes/location_common.conf;
}

# --- Dashboard : supervision / remediation -> http://localhost:8081/ ---
server {
    listen 8081;
    server_name _;
    client_max_body_size 12m;

    # Liste de blocage d'IP pilotee par la remediation (volume partage, recharge
    # par signal HUP). Glob tolerant : si le fichier n'existe pas encore, nginx
    # demarre quand meme. Au niveau server -> deny applique a toutes les routes.
    include /etc/nginx/denylist/*.conf;

    location / {
        set $app dashboard;
        proxy_pass http://$app:8080;
        include includes/proxy_common.conf;
    }

    # --- Services IA, specifiques au dashboard (prefixe CONSERVE : pas de rewrite) ---
    # detector et assistant servent deja leurs routes avec le prefixe
    # (/detector/v1/..., /assistant/v1/...), donc proxy_pass simple.
    location /detector/ {
        set $svc detector;
        proxy_pass http://$svc:8000;
        include includes/proxy_common.conf;
    }

    location /assistant/ {
        set $svc assistant;
        proxy_pass http://$svc:8000;
        include includes/proxy_common.conf;
    }

    include includes/waf_api_routes.conf;
    include includes/location_common.conf;
}

# --- Back-office : admin + MFA faciale -> http://localhost:8082/ ---
server {
    listen 8082;
    server_name _;
    client_max_body_size 12m;

    # Liste de blocage d'IP pilotee par la remediation (volume partage, recharge
    # par signal HUP). Glob tolerant : si le fichier n'existe pas encore, nginx
    # demarre quand meme. Au niveau server -> deny applique a toutes les routes.
    include /etc/nginx/denylist/*.conf;

    location / {
        set $app backoffice;
        proxy_pass http://$app:8080;
        include includes/proxy_common.conf;
    }

    include includes/waf_api_routes.conf;
    include includes/location_common.conf;
}
