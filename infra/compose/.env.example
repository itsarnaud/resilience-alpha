# Modèle de configuration commun aux 3 piles (infra, dev, cyber).

# --- Pile Dev : bases PostgreSQL (une par service) ---
DB_AUTH_USER=auth_user
DB_AUTH_PASSWORD=auth-dev-pwd
DB_AUTH_NAME=auth
DB_PAIEMENT_USER=api_user
DB_PAIEMENT_PASSWORD=paiement-dev-pwd
DB_PAIEMENT_NAME=payments
DB_REMEDIATION_USER=remediation_user
DB_REMEDIATION_PASSWORD=remediation-dev-pwd
DB_REMEDIATION_NAME=remediation

# --- Pile Dev : comptes seedés par auth ---
SEED_OPERATOR_EMAIL=operator@resilience.local
SEED_OPERATOR_PASSWORD=operator-dev-pwd
SEED_VICTIM_EMAIL=victime@resilience.local
SEED_VICTIM_PASSWORD=azerty123
SEED_ADMIN_EMAIL=admin@resilience.local
SEED_ADMIN_PASSWORD=admin-dev-pwd

# --- Pile Dev : secrets des comptes de service (svc:detector, svc:dashboard, svc:remediation) ---
# Même valeur côté auth (SEED_SVC_REMEDIATION_SECRET) et côté remediation (REMEDIATION_CLIENT_SECRET) :
# ici une seule variable (SVC_REMEDIATION_SECRET) alimente les deux, pour qu'elles restent égales.
SVC_DETECTOR_SECRET=dev-detector-secret
SVC_DASHBOARD_SECRET=dev-dashboard-secret
SVC_REMEDIATION_SECRET=dev-remediation-secret

# --- Pile Dev : identifiants MQTT de auth sur le broker mosquitto (pile infra) ---
# Vide tant que mosquitto.conf autorise les connexions anonymes (allow_anonymous true, cas actuel).
# À remplir quand cyber/l'IoT active l'authentification sur le broker (voir services/auth/README.md).
MQTT_AUTH_USERNAME=
MQTT_AUTH_PASSWORD=

# --- Pile Infra ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-dev-pwd
